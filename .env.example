# bpuu-workflow environment configuration
# Copy this file to .env and fill in real values for the KMUTT ADFS integration.
# Never commit .env — it is already listed in .gitignore.

# Local port the app listens on.
PORT=9999

# OIDC discovery document URL exposed by KMUTT's ADFS farm, e.g.
# https://auth.example.kmutt.ac.th/adfs/.well-known/openid-configuration
# The app fetches this on startup to learn the authorization/token/jwks endpoints.
ADFS_DISCOVERY_URL=https://your-adfs-host.example.com/adfs/.well-known/openid-configuration

# Client ID of the ADFS Relying Party Trust / Application Group client registered for this app.
ADFS_CLIENT_ID=replace-with-your-client-id

# Client secret for the same client. Keep this out of source control.
ADFS_CLIENT_SECRET=replace-with-your-client-secret

# Redirect URI this app will send in the authorization request and token exchange.
# MUST exactly match a redirect URI registered on the ADFS Relying Party Trust for
# this client (protocol, host, port, and path all have to match), or ADFS will
# reject the auth request with an invalid redirect URI error. ADFS requires HTTPS
# for every redirect_uri, including localhost — generate a local cert (see
# certs/cert.pem + certs/key.pem, e.g. via mkcert) to run this over HTTPS locally.
REDIRECT_URI=https://localhost:9999/redirect

# Where ADFS should send the browser after a successful logout (end_session).
POST_LOGOUT_REDIRECT_URI=https://localhost:9999/

# Space-separated OIDC scopes to request.
SCOPE=openid profile email

# Random string used to sign the express-session cookie. Generate your own,
# e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
SESSION_SECRET=replace-with-a-random-string

# -----------------------------------------------------------------------------
# ThaID (Thailand national digital ID, run by DOPA/กรมการปกครอง) OAuth2
# configuration. Powers the /external (บุคคลภายนอก) login flow — a second,
# independent identity provider alongside the ADFS config above. None of these
# are required for the app to boot: if they are unset (or ThaID discovery is
# unreachable), the KMUTT/ADFS flow above keeps working fine and /external
# simply shows a friendly "ThaID ยังไม่พร้อมใช้งาน" page until configured.
# -----------------------------------------------------------------------------

# Base URL of the ThaID OAuth2 service. Defaults to DOPA's production host if
# unset. Point this at DOPA's sandbox host instead while testing, if/when one
# is provided.
THAID_BASE_URL=https://imauth.bora.dopa.go.th

# Client ID issued by DOPA for this Relying Party (RP) application.
THAID_CLIENT_ID=replace-with-your-thaid-client-id

# Client secret for the same RP application. Keep this out of source control.
# Unlike ADFS_CLIENT_SECRET above, this is sent ONLY via an HTTP Basic auth
# header on the token request, never as a form body field — that's how
# ThaID's token endpoint expects client credentials.
THAID_CLIENT_SECRET=replace-with-your-thaid-client-secret

# Redirect URI this app sends in the ThaID authorization request and reuses
# in the token exchange. MUST exactly match a redirect URI registered with
# DOPA for this client, and must be HTTPS (see the certs/ notes above — this
# app already runs HTTPS locally for the ADFS flow, so no extra setup needed).
# Note the path: /callback, deliberately separate from ADFS's /redirect.
THAID_REDIRECT_URI=https://localhost:9999/callback

# Space-separated list of ThaID scopes to request. Every value other than the
# special 'openid' is a PII field DOPA will return (pid, name, birthdate,
# etc.); including 'openid' causes the requested PII to be delivered inside a
# signed id_token (JWT) instead of as plain, unsigned top-level JSON fields.
# Our registered client's scope is 'pid name' (no openid) — plain fields.
THAID_SCOPE=pid name

# -----------------------------------------------------------------------------
# KMUTT Master Data (server-to-server client-credentials API) configuration.
# Used after a successful ADFS login (/redirect) to look up whether the user
# is staff or a student, so the client can show the right menu items. This is
# a plain client-credentials API — our backend calls it directly, no browser
# redirect involved. None of these are required for the app to boot: if they
# are unset (or Master Data is unreachable), KMUTT/ADFS login still works
# fine, it just falls back to the existing generic behavior (every menu item
# shown) instead of classifying the user as staff/student.
# -----------------------------------------------------------------------------

# Base URL of the Master Data API. Defaults to KMUTT's production host if unset.
MASTERDATA_BASE_URL=https://master-data.kmutt.ac.th

# Client ID issued for this app's Master Data API client credentials.
MASTERDATA_CLIENT_ID=replace-with-your-masterdata-client-id

# Client secret for the same client. Keep this out of source control.
MASTERDATA_CLIENT_SECRET=replace-with-your-masterdata-client-secret

# -----------------------------------------------------------------------------
# JotForm API (read-only) — OPTIONAL, only for the /admin request list.
# -----------------------------------------------------------------------------
# The request submissions live in JotForm, not in this app. The /admin page
# reads them (and each request's สถานะดำเนินการ / q68) through JotForm's
# submissions API. Without JOTFORM_API_KEY the whole app still works — /admin
# just shows a "not configured" notice instead of the request list.
#
# Get the key from JotForm: Account → API → Create New Key (History/read
# scope is enough). Keep it out of source control.
JOTFORM_API_KEY=replace-with-your-jotform-api-key

# Base URL of the JotForm API. Defaults to the public host if unset. Use a
# region-specific host (e.g. https://eu-api.jotform.com) only if your JotForm
# account is on that region.
JOTFORM_API_BASE_URL=https://api.jotform.com

# The Request Form's id. Defaults to the form id hardcoded in js/app.js, so
# you normally don't need to set this.
JOTFORM_FORM_ID=261200763585052

# -----------------------------------------------------------------------------
# Admin allowlist seed — OPTIONAL.
# -----------------------------------------------------------------------------
# The FIRST admin email, used ONLY to create admin-allowlist.json on first
# boot if that file doesn't exist. After that, the file is the source of
# truth and is managed from the /admin settings zone. Defaults to
# chotthanin.neti@kmutt.ac.th if unset.
ADMIN_SEED_EMAIL=chotthanin.neti@kmutt.ac.th
